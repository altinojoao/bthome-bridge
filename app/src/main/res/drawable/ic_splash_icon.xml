<?xml version="1.0" encoding="utf-8"?>
<!-- Drawable dedicado ao ecra de arranque (windowSplashScreenAnimatedIcon).
     Separado de ic_launcher_foreground.xml (usado no icone do launcher).

     A especificacao do Android 12+ para este atributo exige um canvas
     de 432dp, quatro vezes o tamanho de um icone adaptativo normal
     de 108dp, com o conteudo visivel dentro dos 2/3 centrais (288dp).
     Usar aqui o drawable de 108dp do launcher fica fora dessa
     especificacao e faz a biblioteca de compatibilidade
     androidx.core.splashscreen rebentar internamente com
     NullPointerException ao construir a View do icone, antes de
     qualquer codigo da app correr. Motivo do crash imediato ao abrir,
     corrigido por este ficheiro.

     O desenho e identico ao de ic_launcher_foreground.xml, escalado
     quatro vezes (viewport 432 em vez de 108), mantendo a mesma
     posicao relativa e centrada. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="432dp"
    android:height="432dp"
    android:viewportWidth="432"
    android:viewportHeight="432">
    <path
        android:strokeColor="#2BA6E0"
        android:strokeWidth="12"
        android:strokeAlpha="0.35"
        android:pathData="M216,216 m-128,0 a128,128 0 1,0 256,0 a128,128 0 1,0 -256,0" />
    <path
        android:strokeColor="#2BA6E0"
        android:strokeWidth="22"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M216,128 L272,172 L216,216 L272,260 L216,304 L216,128 M160,172 L272,260 M160,260 L272,172" />
</vector>
